# actbrow UI configuration — copy to .env.local for local dev. Restart `next dev` after changes.
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put secrets here.

# Google Sign-In web client ID (public). Required for login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Backend target. /api/* is proxied here by next.config.js; the widget SDK also loads from it.
NEXT_PUBLIC_API_PROXY_TARGET=http://localhost:8080
NEXT_PUBLIC_ACTBROW_BASE_URL=http://localhost:8080

# Canonical public URLs used for SEO/GEO (metadataBase, robots.txt, sitemap.xml, JSON-LD).
# Set these to your production domain and repo so absolute URLs resolve correctly.
NEXT_PUBLIC_SITE_URL=https://actbrow.depak.dev
NEXT_PUBLIC_GITHUB_URL=https://github.com/depak7/actBrow

# PostHog product analytics (optional). The project token is a public ingest key.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
